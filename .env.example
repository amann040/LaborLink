# Required in every environment. Generate a long random value; never commit it.
LABORLINK_SECRET_KEY=replace-with-a-long-random-secret

# Comma-separated browser origins allowed to call the API.
LABORLINK_CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500

# For Render, point this at the mounted persistent disk.
LABORLINK_DB_URL=sqlite:////var/data/laborlink.db
