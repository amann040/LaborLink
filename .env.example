# Required in every environment. Generate a long random value; never commit it.
LABORLINK_SECRET_KEY=replace-with-a-long-random-secret

# Comma-separated browser origins allowed to call the API.
LABORLINK_CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500

# Local development SQLite database.
LABORLINK_DB_URL=sqlite:///./laborlink.db

# Render PostgreSQL alternative. Use the internal connection URL from the
# Render Postgres Connect page; never commit the URL or its credentials.
# LABORLINK_DB_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# SQLite alternative for a paid Render service with a persistent disk.
# LABORLINK_DB_URL=sqlite:////var/data/laborlink.db
